# Copy this file to .env and replace placeholders.
# Generate a local key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional: add your own Razorpay test credentials for payment-flow development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
